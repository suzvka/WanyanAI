{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppearanceConfig",
  "description": "外观配置，定义品牌展示和单一主题色派生规则",
  "type": "object",
  "properties": {
    "brand": {
      "type": "object",
      "description": "品牌配置",
      "properties": {
        "name": {
          "type": "string",
          "description": "品牌名称",
          "default": "AudienceAI"
        },
        "slogan": {
          "type": "string",
          "description": "品牌副标题/Slogan",
          "default": ""
        },
        "fontFamily": {
          "type": "string",
          "description": "品牌名字体，使用 CSS 变量或字体名",
          "default": "var(--font-serif)"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "description": "主题配置",
      "properties": {
        "primary": {
          "type": "string",
          "description": "主题种子色（HEX 格式，派生全站非黑白颜色）",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#2e2e2e"
        },
        "backgroundOpacity": {
          "type": "object",
          "description": "背景透明度配置",
          "properties": {
            "light": {
              "type": "number",
                "description": "亮色模式下品牌背景的主题色混合强度",
              "minimum": 0,
              "maximum": 1,
              "default": 0.05
            },
            "dark": {
              "type": "number",
                "description": "暗色模式下品牌背景的主题色混合强度",
              "minimum": 0,
              "maximum": 1,
              "default": 0.18
            }
          },
          "required": ["light", "dark"],
          "additionalProperties": false
        },
        "brandColorOffset": {
          "type": "object",
          "description": "品牌名色差配置（正值为更亮，负值为更暗）",
          "properties": {
            "light": {
              "type": "number",
                "description": "亮色模式下品牌名的主题色偏移（负值更暗）",
              "default": -0.08
            },
            "dark": {
              "type": "number",
                "description": "暗色模式下品牌名的主题色偏移（正值更亮）",
              "default": 0.04
            }
          },
          "required": ["light", "dark"],
          "additionalProperties": false
        }
      },
      "required": ["primary", "backgroundOpacity", "brandColorOffset"],
      "additionalProperties": false
    }
  },
  "required": ["brand", "theme"],
  "additionalProperties": false
}
