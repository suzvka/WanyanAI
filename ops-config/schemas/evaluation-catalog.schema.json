{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "textTypes",
    "textCompletenessOptions",
    "evaluationGoals",
    "readerPreferences",
    "feedbackStyles",
    "specialConstraints"
  ],
  "properties": {
    "textTypes": { "$ref": "#/$defs/options" },
    "textCompletenessOptions": { "$ref": "#/$defs/options" },
    "evaluationGoals": { "$ref": "#/$defs/options" },
    "readerPreferences": { "$ref": "#/$defs/options" },
    "feedbackStyles": { "$ref": "#/$defs/options" },
    "specialConstraints": { "$ref": "#/$defs/options" }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["value", "label", "description", "enabled", "sortOrder"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "badge": { "type": "string" },
        "recommended": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "additionalProperties": false
}
