{
  "id": "poetry-evaluate",
  "name": "诗词评价报告",
  "description": "AI 驱动的诗词文本深度鉴赏",
  "route": "/evaluate/poetry-evaluate",
  "containers": [
    { "type": "analysis-controls" },
    { 
      "type": "text-blocks", 
      "params": { 
        "id": "poetry-work",
        "title": "作品",
        "defaultExpanded": true, 
        "initialBlockCount": 1 
      } 
    },
    { 
      "type": "text-blocks", 
      "params": { 
        "id": "reference-evaluation",
        "title": "参考评价",
        "defaultExpanded": false, 
        "initialBlockCount": 0 
      } 
    }
  ],
  "outputMode": "report-json",
  "sidebar": {
    "enabled": true,
    "icon": "Feather",
    "order": 2
  }
}
