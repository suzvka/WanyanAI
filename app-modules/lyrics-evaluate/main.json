{
  "slug": "lyrics-evaluate",
  "title": "歌词评审",
  "description": "词作意境、韵脚考究与文本情感体验诊断",
  "route": "/evaluate/lyrics-evaluate",
  "containers": [
    { "type": "analysis-controls" },
    { 
      "type": "text-blocks", 
      "params": { 
        "id": "main-text",
        "title": "歌词正文",
        "subtitle": "待评文本",
        "prompt": "只有这部分需要评分",
        "defaultExpanded": true, 
        "initialBlockCount": 1 
      } 
    },
    { 
      "type": "text-blocks", 
      "params": { 
        "id": "reference-material",
        "title": "相关背景", 
        "defaultExpanded": false, 
        "initialBlockCount": 0 
      } 
    }
  ],
  "outputMode": "literary-review",
  "entry": {
    "enabled": true,
    "icon": "Music",
    "order": 10
  }
}