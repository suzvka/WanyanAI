{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm install --prefer-frozen-lockfile --prefer-offline --loglevel debug --reporter=append-only && pnpm next build && pnpm tsup src/server.ts --format cjs --platform node --target node20 --outDir dist --no-splitting --no-minify",
    "dev": "npx kill-port 5000 && cross-env PORT=5000 pnpm tsx watch src/server.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "node dist/server.js",
    "ts-check": "tsc -p tsconfig.json",
    "lint:build": "eslint . --quiet",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build)$/'"
  },
