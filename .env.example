# =============================================================================
# WanyanAI 环境变量配置示例
# =============================================================================
# 将此文件复制为 .env 并修改为你实际的值：
#   cp .env.example .env
#
# 项目使用 yunzone-service-kit 的 loadEnv 自动加载 .env 文件（dotenv: true），
# 启动时自动读取，无需手动设置环境变量。
# 本文件仅包含通用配置项，平台特有的实现参数请在对应模块代码中查看。
# =============================================================================


# ── 部署面 ──────────────────────────────────────────────────────────────────
# 这些变量通常由部署平台自动注入，本地开发按需设置即可。

# 部署环境：PROD / DEV（默认 DEV）
# DEPLOY_ENV=DEV

# 服务对外域名（用于构造回调 URL、分享链接等）
# PROJECT_DOMAIN_DEFAULT=https://your-domain.com

# 服务对外 baseUrl（优先级高于 PROJECT_DOMAIN_DEFAULT）
# PUBLIC_BASE_URL=https://your-domain.com

# 部署平台标识：coze / self（默认 coze，自托管设为 self）
# DEPLOY_PROVIDER=coze

# 工作区路径（默认当前工作目录）
# WORKSPACE_PATH=/workspace/projects

# 监听端口（默认 5000）
# PORT=5000


# ── 鉴权中心面（Token Authority Service）────────────────────────────────────
# 可选：未配置时权限降级为 fallback（permissionLevel=1）

# 鉴权服务 base URL
# AUTH_CENTER_URL=https://auth.example.com

# 客户端凭证（格式：sk-client-xxx）
# AUTH_CENTER_API_KEY=sk-client-your-key

# 产品标识（用于隔离不同产品的 Token 空间）
# AUTH_CENTER_PRODUCT_ID=prod-xxx


# ── 用户中心面 ──────────────────────────────────────────────────────────────
# 可选：未配置时用户登录功能不可用

# 用户中心服务端 URL
# USER_CENTER_URL=https://uc.example.com

# 用户中心客户端 URL（Next.js 构建时内联用，浏览器端访问）
# 注：如果与 USER_CENTER_URL 相同，只设一个即可
# NEXT_PUBLIC_USER_CENTER_URL=https://uc.example.com

# 用户中心 API Key
# USER_CENTER_API_KEY=sk-uc-your-key


# ── 管理面 ──────────────────────────────────────────────────────────────────
# 可选：ADMIN_PASSWORD 未设置时管理后台返回 503

# 管理后台密码
# ADMIN_PASSWORD=your-secure-password

# 管理后台路径前缀（默认 /admin）
# ADMIN_PATH=/admin


# ── 配置存储 ────────────────────────────────────────────────────────────────
# 可选：默认 file（写入 runtime-config/ 目录）

# 配置存储模式：file（本地文件） / db（数据库）
# CONFIG_STORE=file


# ── 数据库（Supabase）───────────────────────────────────────────────────────
# 可选：未配置时数据库相关功能不可用

# Supabase 项目 URL
# SUPABASE_URL=https://xxxxx.supabase.co

# Supabase 匿名密钥（anon key）
# SUPABASE_ANON_KEY=eyJxxx...

# Supabase 服务角色密钥（用于服务端操作，有更高权限）
# SUPABASE_SERVICE_ROLE_KEY=eyJxxx...


# ── 账户服务（遗留兼容）─────────────────────────────────────────────────────
# 可选

# 账户服务 URL
# ACCOUNT_SERVICE_URL=https://account.example.com


# ── 日志 ────────────────────────────────────────────────────────────────────
# 可选

# 日志级别：trace / debug / info / warn / error / fatal
# 默认：development=debug, production=info
# LOG_LEVEL=info

# 日志美化输出（JSON 转可读格式）
# 默认：development=true, production=false
# LOG_PRETTY=true

# Node.js 环境
# NODE_ENV=development