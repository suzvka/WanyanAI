# =============================================================================
# WanyanAI 环境变量配置示例
# =============================================================================
# 将此文件复制为 .env 并修改为你实际的值：
#   cp .env.example .env
#
# 项目使用 yunzone-service-kit 的 loadEnv 自动加载 .env 文件（dotenv: true），
# 启动时自动读取，无需手动设置环境变量。
# 本文件仅包含通用配置项，平台特有的实现参数请在对应模块代码中查看。
# =============================================================================


# ── 部署面 ──────────────────────────────────────────────────────────────────
# 这些变量通常由部署平台自动注入，本地开发按需设置即可。

# 部署环境：PROD / DEV（默认 DEV）
# DEPLOY_ENV=DEV

# 服务对外域名（用于构造回调 URL、分享链接等）
# PROJECT_DOMAIN_DEFAULT=https://your-domain.com

# 服务对外 baseUrl（优先级高于 PROJECT_DOMAIN_DEFAULT）
# PUBLIC_BASE_URL=https://your-domain.com

# 部署平台分派键：self（默认，通用模式，中立键直读）/ coze（Coze 平台部署必须显式设置，启用 COZE_* / DEPLOY_RUN_PORT 平台注入回退）
# DEPLOY_PROVIDER=self

# 监听端口（默认 5000）
# PORT=5000


# ── 鉴权中心面（Token Authority Service）────────────────────────────────────
# 可选：未配置时权限降级为 fallback（permissionLevel=1）

# 鉴权服务 base URL（必须带协议，如 https://）
# AUTH_CENTER_URL=https://auth.example.com

# 鉴权中心签发的唯一凭证（格式：sk-client-xxx）
# 既是直连鉴权中心 /api/v1/token/* 的 API Key，也是平台认证 OAuth 接入的
# client_secret（client_id = SHA-256(apiKey)，服务端自动派生）；
# 签发时需登记 redirectUris（含本服务 /auth/callback），
# 且 productId 必须与 AUTH_CENTER_PRODUCT_ID 一致
# AUTH_CENTER_API_KEY=sk-client-your-key

# 产品标识（用于隔离不同产品的 Token 空间）
# AUTH_CENTER_PRODUCT_ID=prod-xxx


# ── 平台认证面（云洲平台统一认证服务）────────────────────────────────────
# 可选：未配置时用户登录功能不可用

# 平台认证服务 base URL（当前实现者为用户中心，必须带协议；浏览器侧由
# 服务端经 /api/v1/config 运行时下发，用于登录弹窗地址）
# PLATFORM_AUTH_URL=https://uc.example.com


# ── 管理面 ──────────────────────────────────────────────────────────────────
# 可选：ADMIN_PASSWORD 未设置时管理后台返回 503

# 管理后台密码
# ADMIN_PASSWORD=your-secure-password

# 管理后台会话有效期（秒），默认 86400（24 小时）
# ADMIN_SESSION_MAX_AGE=86400


# ── 配置存储 / 数据库 ───────────────────────────────────────────────────────
# 配置存储统一构建在数据库抽象（SqlDb）之上，渠道唯一来源 = DATABASE_PROVIDER，
# 无独立存储开关。渠道值域：postgres / coze / none。

# 数据库渠道：
#   postgres（默认，通用，走 DATABASE_URL）/ coze（Coze 平台数据库集成，走 PG* 注入组）
#   none（显式无库：配置存储走 FileSqlDb 本地 json 模拟，无需真实数据库）
# DATABASE_PROVIDER=postgres

# 通用连接串（DATABASE_PROVIDER=postgres 时使用）
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Coze 平台拆分参数（DATABASE_PROVIDER=coze 时由平台注入，无需手填）
# PGDATABASE_URL=postgresql://user:password@host:5432/db
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=postgres
# PGSSLMODE=require


# ── 日志 ────────────────────────────────────────────────────────────────────
# 可选

# 日志级别：trace / debug / info / warn / error / fatal
# 默认：development=debug, production=info
# LOG_LEVEL=info

# 日志美化输出（JSON 转可读格式）
# 默认：development=true, production=false
# LOG_PRETTY=true

# Node.js 环境
# NODE_ENV=development